classDiagram
  direction LR

  class Usuario {
    -int id
    -String nombre
    -String correo
    -String passwordHash
    -Rol rol
  }
  class Rol {
    <<enumeration>>
    auxiliar
    analista
    coordinador
    admin
  }
  class Vacante {
    -int id
    -String codigo
    -String titulo
    -String descripcion
    -String area
    -String ubicacion
    -String modalidad
    -String contrato
    -String salario
    -String responsabilidades
    -String ofrecemos
    -EstadoVacante estado
    -JSON requisitos
    -JSON pesos
    +admitePostulaciones() boolean
  }
  class Candidato {
    -int id
    -String nombre
    -String correo
    -String telefono
    -String documento
    -boolean aceptaDatos
  }
  class Postulacion {
    -int id
    -String numero
    -Canal canal
    -EstadoPostulacion estado
    -Clasificacion clasificacion
    -double puntaje
    -String procesoId
    -String rrhhId
    -Date recibidaEn
    +cambiarEstado(String)
  }
  class HojaDeVida {
    -String archivoPath
    -String archivoHash
    +validarDocumento() boolean
  }
  class Extraccion {
    -JSON datos
    -JSON confianza
    -String resumen
    -double aniosExperiencia
    -JSON datosValidados
    -double costoUsd
  }
  class Decision {
    -TipoDecision tipo
    -String resultado
    -String observacion
    -Date creadaEn
  }
  class Expediente {
    <<sistema RR.HH.>>
    -String rrhhId
    -Date fechaCreacion
    +actualizar()
  }
  class Incidencia {
    -Origen origen
    -String detalle
    -String capturaPath
    -boolean resuelta
  }
  class EventoAuditoria {
    -String actor
    -String accion
    -String resultado
    -JSON detalle
    -Date creadoEn
  }
  class Notificacion {
    -String destinatario
    -String plantilla
    -boolean enviada
  }
  class PlantillaCorreo {
    -String clave
    -String asunto
    -String cuerpo
  }
  class MotorReglas {
    <<servicio>>
    +evaluar(datos, anios, requisitos, pesos) Evaluacion
  }
  class ServicioExtraccionIA {
    <<servicio>>
    +extraer(archivo) Extraccion
  }
  class RobotRPA {
    <<servicio>>
    +registrar(postulacion) String
  }
  class CalendarioHabil {
    <<servicio>>
    +plazoEscalacion(inicio) Duracion
  }

  Usuario --> Rol
  Usuario "1" --> "0..*" Vacante : publica y edita
  Candidato "1" --> "0..*" Postulacion : realiza
  Vacante "1" --> "0..*" Postulacion : recibe
  Postulacion "1" *-- "1" HojaDeVida : adjunta
  Postulacion "1" --> "0..*" Extraccion : se extrae en
  Postulacion "1" --> "0..*" Decision : registra
  Usuario "1" --> "0..*" Decision : toma
  Postulacion "1" --> "0..1" Expediente : se organiza en
  Postulacion "1" --> "0..*" Incidencia : genera
  Postulacion "1" --> "0..*" EventoAuditoria : deja traza
  Postulacion "1" --> "0..*" Notificacion : envia
  Notificacion "0..*" --> "1" PlantillaCorreo : usa
  MotorReglas ..> Postulacion : puntua
  ServicioExtraccionIA ..> Extraccion : produce
  RobotRPA ..> Expediente : crea
  CalendarioHabil ..> Postulacion : fija plazo de escalacion
