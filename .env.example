POSTGRES_USER=reclutamiento
POSTGRES_PASSWORD=cambiar_esto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cadena de respaldo (la capa gratuita permite ~20 peticiones/día por modelo)
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemma-4-26b-a4b-it
FLOWABLE_USER=rest-admin
FLOWABLE_PASSWORD=test
JWT_SECRET=cambiar_esto
INTERNAL_TOKEN=cambiar_esto
SEED_PASSWORD=demo1234
RRHH_USER=robot
RRHH_PASSWORD=robot123
# Buzón de postulaciones (RF-02)
# IMAP_HOST=imap.gmail.com   # por defecto usa el buzón de pruebas GreenMail (compose)
# IMAP_USER=
# IMAP_PASSWORD=

# Escalación de validaciones sin atender al coordinador (RF-19), en formato ISO-8601. Para probar: PT2M
ESCALACION_ISO=PT24H
# "habiles": cuenta ESCALACION_HORAS dentro del horario laboral (ignora ESCALACION_ISO).
# "corridas": usa ESCALACION_ISO tal cual (para la demo: ESCALACION_MODO=corridas y ESCALACION_ISO=PT1M).
ESCALACION_MODO=habiles
ESCALACION_HORAS=24
HORARIO_INICIO=8
HORARIO_FIN=18
HORARIO_UTC=-5
# Festivos que no cuentan, AAAA-MM-DD separados por coma
FESTIVOS=
# Nombre y enlace público que ven los candidatos
EMPRESA_NOMBRE=Empresa S.A.
URL_PUBLICA=http://localhost:8000
# Cada cuántos segundos se buscan tareas nuevas para avisar al personal por correo (RF-29)
AVISOS_INTERVALO=20
